# Supabase (client-side — exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Database (PostgreSQL) - Required for API routes
DATABASE_URL=

# JWT Authentication - Required for API routes
JWT_SECRET=
JWT_EXPIRES_IN=86400
JWT_REFRESH_EXPIRES_IN=604800

# Admin API Secret (required for /api/admin/* endpoints)
ADMIN_SEED_SECRET=

# Backend API base URL
NEXT_PUBLIC_API_BASE_URL=

# Canonical app origin (server-trusted). Used to build the PhonePe post-payment
# return URL instead of the client-supplied Origin header, which is spoofable.
NEXT_PUBLIC_APP_URL=

# CORS — REQUIRED in production. Single origin (no wildcard).
# Example: https://hostel.example.com
CORS_ORIGIN=http://localhost:3000

# MSG91 Configuration (SMS OTP Service)
NODE_ENV=development
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here

# Twilio Configuration (WhatsApp OTP delivery)
# We generate + verify the OTP ourselves; Twilio only delivers it over WhatsApp.
# Production requires an approved WhatsApp authentication template (Content SID).
# Leave blank in dev — sends are logged and skipped when not configured.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_OTP_CONTENT_SID=your_twilio_whatsapp_template_content_sid_here

# PhonePe Payment Gateway (PG Checkout v2 — Standard Checkout)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=SANDBOX
# Configure these same values as the webhook's Basic Auth in the PhonePe dashboard
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
# Optional overrides if PhonePe's published endpoints differ from this codebase's defaults
PHONEPE_AUTH_URL=
PHONEPE_API_BASE_URL=
