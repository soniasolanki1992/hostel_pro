# Hostel Pro Environment Configuration
# Copy this file to .env.prod and fill in your values

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/hostel_pro

# JWT Authentication
JWT_SECRET=generate-a-strong-random-secret-at-least-48-chars
JWT_EXPIRES_IN=86400
JWT_REFRESH_EXPIRES_IN=604800

# Admin API Secret (required for /api/admin/* endpoints)
ADMIN_SEED_SECRET=generate-another-strong-random-secret

# Environment
NODE_ENV=production

# MSG91 OTP Service (required for production OTP delivery)
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_TEMPLATE_ID=your-dlt-approved-template-id

# Mock OTP for local/dev/staging only. MUST NOT be 'true' in production —
# the app will refuse to start. Set MOCK_OTP_VALUE to override the default
# '123456'.
# MOCK_OTP_ENABLED=true
# MOCK_OTP_VALUE=123456

# CORS — required in production. The app will refuse to start in production
# without this. In development it falls back to '*'.
# CORS_ORIGIN=https://hostel.example.com
